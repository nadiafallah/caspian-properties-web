# Copy this file to .env.local for local development and fill in real values.
# Never commit .env.local. On Vercel, add the same names under
# Project → Settings → Environment Variables (mark secrets as "Sensitive").

# ── Site ────────────────────────────────────────────────────────────────
# Public base URL, used for canonical links, hreflang and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "preview" (default): search engines are blocked and missing-content
# markers / photo placeholders are visible for review.
# "launch": markers and unverified details are removed.
NEXT_PUBLIC_SITE_STAGE=preview

# Only matters when the stage is "launch". Set to "false" to keep search engines
# out (e.g. a clean public site on a temporary vercel.app address). Remove it, or
# set "true", once the real domain is live and `npm run check:content` passes.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Cookieless Vercel Web Analytics. Set to "true" only after enabling
# Web Analytics for the project in the Vercel dashboard (otherwise its script 404s).
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# ── Cal.com scheduling (public, not secret) ─────────────────────────────
# Your Cal.com username + event slug, e.g. "nadia-fallah/private-consultation".
NEXT_PUBLIC_CALCOM_LINK=
# Any short identifier for the embed instance.
NEXT_PUBLIC_CALCOM_NAMESPACE=private-consultation
# Only change if you use a Cal.com region/self-hosted instance.
NEXT_PUBLIC_CALCOM_ORIGIN=https://app.cal.com

# ── Cal.com webhook (secret) ────────────────────────────────────────────
# The "Secret" you type when creating the webhook in Cal.com → Settings → Developer → Webhooks.
CALCOM_WEBHOOK_SECRET=

# ── Lead storage ────────────────────────────────────────────────────────
# "supabase" in production ("sheets" still works as an alternative).
# "memory" is for local development only and is refused when NODE_ENV=production.
LEAD_STORE=memory

# Supabase (server-only). See docs/INTEGRATIONS.md.
# Project URL: Supabase Dashboard → Project Settings → Data API.
SUPABASE_URL=
# Secret key (sb_secret_…): Project Settings → API Keys. Secret — never commit.
SUPABASE_SECRET_KEY=

# Google Sheets (server-only secrets). See docs/INTEGRATIONS.md.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key value from the service-account JSON, including the
# BEGIN/END lines. Literal "\n" sequences are converted to newlines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── New-lead notifications (optional; each channel turns on when its values are set) ──
# Telegram: create a bot with @BotFather (token), then message the bot and get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email via Resend (free plan). Without a verified domain, Resend only delivers to your own Resend account email.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL_TO=
LEAD_NOTIFY_EMAIL_FROM=
# WhatsApp via CallMeBot (free, personal use). Activate at https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# ── Rate limiting & duplicate protection (Upstash Redis, free plan) ─────
# Added automatically if you connect Upstash from the Vercel Marketplace
# (it may use the KV_REST_API_URL / KV_REST_API_TOKEN names instead — both work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
